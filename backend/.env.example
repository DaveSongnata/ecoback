# App
TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333
NODE_ENV=development

# Database (uma string só — Supabase em prod, Postgres local em dev)
DATABASE_URL=postgres://app:app@postgres:5432/app

# Storage switch (0 = filesystem local; 1 = Cloudflare R2)
USE_CLOUDFLARE_R2=0

# Cloudflare R2 (só usado quando USE_CLOUDFLARE_R2=1)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Local storage (só usado quando USE_CLOUDFLARE_R2=0)
LOCAL_STORAGE_PATH=/app/storage/uploads
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3333/uploads

# Mail
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Ocorrências"

# Limiter (memory or database)
LIMITER_STORE=memory

# CORS — comma separated; '*' = any (dev only)
CORS_ORIGINS=
