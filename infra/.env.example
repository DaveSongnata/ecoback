# Used by docker-compose.prod.yml — copy to .env (alongside this file) and fill in.

TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=
APP_URL=https://api.example.com

# Supabase Postgres connection string
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Cloudflare R2
USE_CLOUDFLARE_R2=1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.example.com

# Local storage (unused when USE_CLOUDFLARE_R2=1, kept for parity)
LOCAL_STORAGE_PATH=/app/storage/uploads
LOCAL_STORAGE_PUBLIC_URL=

# Mail (your transactional provider's SMTP relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Ocorrências"

LIMITER_STORE=memory

# Comma-separated list. '*' allows everything (not recommended for prod).
CORS_ORIGINS=https://app.example.com
