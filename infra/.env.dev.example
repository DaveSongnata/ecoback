# Defaults para o stack docker-compose.dev.yml.
# Copiado para infra/.env.dev pelo setup.sh.
# APP_KEY é gerada automaticamente — não edite.

TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
APP_KEY=
APP_URL=http://localhost:38383

DATABASE_URL=postgres://app:app@postgres:5432/app
USE_CLOUDFLARE_R2=0

LOCAL_STORAGE_PATH=/app/storage/uploads
LOCAL_STORAGE_PUBLIC_URL=http://localhost:38383/uploads

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Ocorrências

LIMITER_STORE=memory
CORS_ORIGINS=
